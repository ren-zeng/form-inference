(datatype Harmony
    (I)
    (II)
    (III)
    (IV)
    (V)
    (VI)
    (VII)
)

(datatype CadenceStrength
    (None)
    (Weak)
    (Strong)
)

(sort Progression (Vec Harmony))

(datatype Idea
    (Label String :cost 999)
    (LocalVar i64)
    (Concat Idea Idea)
    (Twice Idea)
    (RefIdea String)
)

(birewrite
    (Concat x (Concat y z))
    (Concat (Concat x y) z)
)

(birewrite
    (Concat x x)
    (Twice x)
)

(datatype PhraseParam
    (Param Progression CadenceStrength)
    (ConcatParam PhraseParam PhraseParam)
)

(datatype IdeaBinding
    (BindIdea String Idea)
)

(datatype*
    (FormalUnitBinding
        (BindFormalUnit String FormalUnit)
    )
    ( FormalUnit
        (Leaf Idea PhraseParam)
        (UseIdeaWith Idea PhraseParam)
        (RefFormalUnit String)
        (Sentence IdeaBinding  FormalUnit FormalUnit)
        (Period FormalUnitBinding  FormalUnit FormalUnit)
        (Presentation IdeaBinding FormalUnit FormalUnit)
        (Continuation FormalUnit FormalUnit)
        (Concatenate FormalUnit FormalUnit :cost 999)
    )
)



(constructor GetParam (FormalUnit) PhraseParam )
(constructor GetCadence (FormalUnit) CadenceStrength )
(constructor GetStartingHarmony (FormalUnit) Harmony )


(relation NoWeaker (CadenceStrength CadenceStrength))

(NoWeaker (None) (None))
(NoWeaker (Weak) (Weak))
(NoWeaker (Strong) (Strong))
(NoWeaker (Weak) (None))
(NoWeaker (Strong) (None))
(NoWeaker (Strong) (Weak))


(rule
    (
    (= match (Concatenate x (Concatenate y z)))
    (NoWeaker (GetCadence y) (GetCadence x))
    )
    (
    (union match (Concatenate (Concatenate x y) z))
    )
)

(rule
    (
    (= match (Concatenate (Concatenate x y) z))
    (NoWeaker (GetCadence z) (GetCadence y))
    )
    (
    (union match (Concatenate x (Concatenate y z)))
    )
)

(constructor GetIdea (FormalUnit) Idea)
(rule
    (
        (= match (Leaf x _))
    )
    (
        (union (GetIdea match) x)
    )
)

(rule
    (
        (= match (Concatenate x y))
        (= ideaX (GetIdea x))
        (= ideaY (GetIdea y))
    )
    (
        (union (GetIdea match) (Concat ideaX ideaY))
    )
)

(rule
    (
        (= match (Presentation (BindIdea _ x) a b))
    )
    (
        (union (GetIdea match) (Twice x))
    )
)



(rule
    (
        (= match (Leaf _ (Param x _)))
    )
    (
        (union (GetStartingHarmony match) (vec-get x 0))
    )
)

(rule
    (
        (= match (Concatenate x y))
        (= startingHx (GetStartingHarmony x))
    )
    (
        (union (GetStartingHarmony match) startingHx)
    )
)


(rule
    (
        (= match (Leaf _ (Param _ cad)))
    )
    (
        (union (GetCadence match)  cad)
    )
)

(rule
    (
        (= match (Concatenate x y))
    )
    (
        (union (GetCadence match) (GetCadence y))
    )
)

(rule
    (
        (= match (Leaf _ x))
    )
    (
        (union (GetParam match) x)
    )

)

(rule
    (
        (= match (Concatenate x y))
    )
    (
        (union (GetParam match) (ConcatParam  (GetParam x) (GetParam y)))
    )
)




(rule
    (
        (= match (Concatenate x y))
        (= (GetIdea x) (GetIdea y))
        (= (I) (GetStartingHarmony x))
    )
    (
        (union match 
            (Presentation 
                (BindIdea "b.i." (GetIdea x)) 
                (UseIdeaWith (RefIdea "b.i.") (GetParam x)) 
                (UseIdeaWith (RefIdea "b.i.") (GetParam y)) 
            )
        )
    )
)


(rule
    (
        (= match (Concatenate x y))
        (= (GetCadence x) (None))
        (!= (GetCadence y) (None))
    )
    (
        (union match (Continuation x y))
    )
)

(rule
    (
        (= match (Concatenate u1 u2))
        (= u1 (Presentation (BindIdea _ idea) x y))
        (= u2 (Continuation _ _))
        
    )
    (
        (union match (Sentence (BindIdea "aSent" idea) 
            (Presentation (BindIdea "b.i." (RefIdea "aSent"))
                x y
            ) 
            u2))
    )
)

(rule
    (
        (= match (Concatenate antecedent consequent))
        (= antecedent (Concatenate u1 u2))
        (= consequent (Concatenate u3 u4))
        (= u1 u3)
        (= (GetCadence u2) (Weak))
        (= (GetCadence u4) (Strong))
    )
    (
        (union match (Period (BindFormalUnit "b.i." u1) (Concatenate (RefFormalUnit "b.i.") u2) (Concatenate (RefFormalUnit "b.i.") u4)))
    )
)